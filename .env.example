# Variables de entorno para Alerta Pluvial Puerto Montt
# Copie este archivo a .env y complete con valores propios antes de desplegar.
# NUNCA suba el archivo .env real ni claves privadas al repositorio.

SECRET_KEY=cambiar-por-una-clave-aleatoria-segura-de-64-caracteres
FLASK_DEBUG=0
FLASK_ENV=development
SEED_DEMO_DATA=1
TRUST_PROXY_HEADERS=0

# Claves demo usadas solo si SEED_DEMO_DATA=1 (en producción establecer SEED_DEMO_DATA=0)
DEMO_ADMIN_PASSWORD=CambiarAdminDemo2026!
DEMO_OPERATOR_PASSWORD=CambiarOperadorDemo2026!
DEMO_CITIZEN_PASSWORD=CambiarCiudadanoDemo2026!

# Opcional para despliegue con PostgreSQL (si se omite usa SQLite local):
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd
PORT=5000
